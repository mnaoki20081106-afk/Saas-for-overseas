# ------------------------------------------------------------------
# ローカルで動かすときはこのファイルを .env にコピーして値を入れてください。
# GitHub Actions で動かす場合は、同じ名前で「Secrets」に登録します。
# （Settings → Secrets and variables → Actions → New repository secret）
#
# 何も設定しなくても DRY_RUN=1 で全機能の動作確認ができます。
# ------------------------------------------------------------------

# 【必須】記事・ピン文案・案件リサーチを生成するために使います
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 使うモデル。未設定なら claude-opus-5。
# コストを抑えたいときは claude-sonnet-5 に。
CLAUDE_MODEL=

# 公開サイトの URL（GitHub Actions では Variables の SITE_BASE_URL でも可）
# 例: https://your-name.github.io/saas-for-overseas
SITE_BASE_URL=

# 【推奨】Pinterest への自動投稿と数値取得
# `npm run autopilot pinterest:auth` で REFRESH_TOKEN を取得できます
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REFRESH_TOKEN=
# 手動でアクセストークンを使う場合のみ（通常は不要・期限切れします）
PINTEREST_ACCESS_TOKEN=
# Pinterest のサンドボックス環境を使うなら 1
PINTEREST_SANDBOX=
# サイト所有権の確認コード（Pinterest の Claim website で表示される content="..." の中身だけ）
PINTEREST_VERIFY_CODE=

# 【任意】売上の自動集計。未設定でも記事とピンの自動化は動きます。
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=

SHAREASALE_AFFILIATE_ID=
SHAREASALE_API_TOKEN=
SHAREASALE_API_SECRET=

PARTNERSTACK_API_KEY=
PARTNERSTACK_API_SECRET=

# 1 にすると Claude を呼ばずにサンプルデータで動きます（無料・動作確認用）
DRY_RUN=

# 公式以外の互換エンドポイントを使う場合のみ設定します。
# 設定する前に必ず `npm run autopilot provider:check` で必要な機能が揃っているか確認してください。
# 空欄なら公式（https://api.anthropic.com）を使います。
ANTHROPIC_BASE_URL=
